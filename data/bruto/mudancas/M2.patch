diff --git a/api-clean/src/domain/policies/WipLimit.ts b/api-clean/src/domain/policies/WipLimit.ts
new file mode 100644
index 0000000..f7c3807
--- /dev/null
+++ b/api-clean/src/domain/policies/WipLimit.ts
@@ -0,0 +1,11 @@
+import { ConflictError } from "../errors/DomainErrors";
+import type { TaskRepository } from "../ports";
+
+/** Regra de negócio: no máximo 3 tarefas em andamento por usuário. */
+export const WIP_LIMIT = 3;
+
+export async function assertWithinWipLimit(tasks: TaskRepository, userId: number): Promise<void> {
+  if ((await tasks.countByStatus(userId, "doing")) >= WIP_LIMIT) {
+    throw new ConflictError("Limite de 3 tarefas em andamento atingido");
+  }
+}
